llowing month.\n  d.setDate(1);\n  d.setMonth(d.getMonth() + n);\n  // Day 0 of the next month is the last day of the target month.\n  const lastDay = new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate();\n  d.setDate(Math.min(day, lastDay));\n  return d;\n}"}}}
